<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.akshare</groupId>
        <artifactId>akshare-java</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>akshare-web</artifactId>
    <packaging>jar</packaging>
    <name>AKShare Web</name>
    <description>Web interface for AKShare Java library</description>

    <properties>
        <java.version>1.8</java.version>
        <spring-boot.version>2.7.18</spring-boot.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- Spring Boot Starter Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- AKShare Modules -->
        <dependency>
            <groupId>com.akshare</groupId>
            <artifactId>akshare-stock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.akshare</groupId>
            <artifactId>akshare-fund</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.akshare</groupId>
            <artifactId>akshare-futures</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.akshare</groupId>
            <artifactId>akshare-bond</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.akshare</groupId>
            <artifactId>akshare-macro</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
